{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>wielorzeczownik/.github"],
  "packageRules": [
    {
      "matchManagers": ["pep621"],
      "semanticCommitType": "build"
    },
    {
      "matchManagers": ["regex"],
      "matchFileNames": [".github/workflows/**"],
      "semanticCommitType": "ci"
    }
  ]
}
